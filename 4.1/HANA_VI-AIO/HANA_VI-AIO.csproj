<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>HANA_VI-AIO</AssemblyName>
    <RootNamespace>HanaVi.Aio</RootNamespace>
    <Version>4.1.0</Version>
  </PropertyGroup>

  <!-- 공용 엔진(Shared/)을 이 모드 전용 이름공간(<RootNamespace>.Shared)으로 복사해 컴파일한다.
       모드끼리 같은 클래스 이름이 겹치면 SPT DI 가 하나만 등록해서 서버가 죽기 때문이다.
       자세한 이유는 ../Directory.Build.targets 맨 위 설명. -->
  <PropertyGroup>
    <HanaViUseShared>true</HanaViUseShared>
  </PropertyGroup>
</Project>
