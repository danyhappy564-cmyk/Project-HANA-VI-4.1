<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>HANA-VI-SuperAmmo</AssemblyName>
    <RootNamespace>HanaVi.SuperAmmo</RootNamespace>
    <Version>4.1.0</Version>
  </PropertyGroup>

  <!-- 공용 엔진(Shared/)을 이 모드 전용 이름공간(<RootNamespace>.Shared)으로 복사해 컴파일한다.
       모드끼리 같은 클래스 이름이 겹치면 SPT DI 가 하나만 등록해서 서버가 죽기 때문이다.
       자세한 이유는 ../Directory.Build.targets 맨 위 설명. -->
  <PropertyGroup>
    <HanaViUseShared>true</HanaViUseShared>
  </PropertyGroup>

  <!-- 번들(에셋)과 bundles.json 은 mod/ 아래에 있어서
       Directory.Build.props 의 <None Include="mod\**\*" /> 가 알아서 출력 폴더로 복사한다. -->
</Project>
